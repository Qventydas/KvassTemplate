code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 MixParameter : source_color;
uniform float ScrollSpeed;
uniform sampler2D Texture : repeat_enable;



void fragment() {
// ColorParameter:11
	vec4 n_out11p0 = MixParameter;


// Input:4
	vec2 n_out4p0 = UV;


// Input:6
	float n_out6p0 = TIME;


// FloatParameter:9
	float n_out9p0 = ScrollSpeed;


// FloatOp:8
	float n_out8p0 = n_out6p0 / n_out9p0;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0, 0.0) + vec3(n_out8p0);


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Texture, vec2(n_out5p0.xy));


	vec3 n_out12p0;
// ColorOp:12
	{
		float base = vec3(n_out11p0.xyz).x;
		float blend = vec3(n_out2p0.xyz).x;
		if (base < 0.5) {
			n_out12p0.x = 2.0 * base * blend;
		} else {
			n_out12p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out11p0.xyz).y;
		float blend = vec3(n_out2p0.xyz).y;
		if (base < 0.5) {
			n_out12p0.y = 2.0 * base * blend;
		} else {
			n_out12p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out11p0.xyz).z;
		float blend = vec3(n_out2p0.xyz).z;
		if (base < 0.5) {
			n_out12p0.z = 2.0 * base * blend;
		} else {
			n_out12p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Output:0
	COLOR.rgb = n_out12p0;


}
