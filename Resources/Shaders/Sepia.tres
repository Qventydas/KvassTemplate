code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_3 : hint_screen_texture;



void fragment() {
// Input:2
	vec2 n_out2p0 = SCREEN_UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(screen_tex_frg_3, n_out2p0);


	vec3 n_out4p0;
// ColorFunc:4
	{
		vec3 c = vec3(n_out3p0.xyz);
		float r = (c.r * .393) + (c.g *.769) + (c.b * .189);
		float g = (c.r * .349) + (c.g *.686) + (c.b * .168);
		float b = (c.r * .272) + (c.g *.534) + (c.b * .131);
		n_out4p0 = vec3(r, g, b);
	}


// Mix:5
	float n_in5p2 = 0.30000;
	vec4 n_out5p0 = mix(n_out3p0, vec4(n_out4p0, 0.0), n_in5p2);


// FloatConstant:6
	float n_out6p0 = 1.000000;


// Output:0
	COLOR.rgb = vec3(n_out5p0.xyz);
	COLOR.a = n_out6p0;


}
"
